{
  // The connected Cloudflare project is smoke-catalog; the repository is somke-catalog.
  "name": "smoke-catalog",
  "main": "workers/preferences.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
  // Routes are managed in the dashboard: smoke.inneros.asia/* only.
  // Omit route/routes so deployment preserves that dashboard-managed route.
}
