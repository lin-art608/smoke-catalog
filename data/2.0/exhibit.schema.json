{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Smoke Archive 2.0 G1 seed exhibit",
  "type":"object",
  "required":["id","name","provinceId","packFront","packagingVersion","observations","observationEvidence","sourceReferences","reading","type","alternative","translations","lore","loreKind","folkSayings","relatedIds","imageRights","imageResolution","characterStatus","votes"],
  "properties":{
    "id":{"type":"string","pattern":"^sku-"},
    "name":{"type":"string","minLength":1},
    "packagingVersion":{"type":["string","null"]},
    "observations":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"string","minLength":4}},
    "observationEvidence":{"type":"object","required":["localPath","reviewed","method"]},
    "sourceReferences":{"type":"array","minItems":1,"items":{"type":"object","required":["title","url","accessed","certainty"]}},
    "reading":{"type":"string","minLength":20},
    "translations":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}}},
    "lore":{"type":"string","minLength":120,"maxLength":250},
    "loreKind":{"const":"original-fiction"},
    "folkSayings":{"type":"array","items":{"type":"object","required":["text","source","certainty"]}},
    "relatedIds":{"type":"array","minItems":2,"maxItems":4,"uniqueItems":true,"items":{"type":"string"}},
    "imageRights":{"type":"object","required":["status","publicReplacementAllowed"],"properties":{"publicReplacementAllowed":{"const":false}}},
    "imageResolution":{"type":"object","required":["status","hdVerified"],"properties":{"hdVerified":{"const":false}}},
    "votes":{"type":"object","required":["status","count"],"properties":{"status":{"const":"not-open"},"count":{"type":"null"}}}
  }
}
